@model CorporateTrainingSystem.Application.Features.Employees.UpdateEmployee.UpdateEmployeeCommand
@{
    ViewData["Title"] = "Edit Employee";
}

<div class="page-header-row mb-4">
    <div>
        <div class="page-badge-label">
            <span class="page-badge-dot"></span>
            Personnel Management
        </div>
        <h1 class="page-title">Edit Employee Profile</h1>
        <p class="page-subtitle">Update employee records, job title, and department assignment.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn-skill-outline">
            <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back</span>
            <span>Back to Employees</span>
        </a>
    </div>
</div>

<div class="form-card-container">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-6 form-group-custom">
                <label asp-for="EmployeeNumber">Employee Number *</label>
                <input asp-for="EmployeeNumber" class="form-control-custom" placeholder="e.g., EMP-1049" required />
                <span asp-validation-for="EmployeeNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-6 form-group-custom">
                <label asp-for="FullName">Full Name *</label>
                <input asp-for="FullName" class="form-control-custom" placeholder="e.g., Sarah T. Sterling" required />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 form-group-custom">
                <label asp-for="Email">Email Address *</label>
                <input asp-for="Email" type="email" class="form-control-custom" placeholder="e.g., sarah@company.com" required />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6 form-group-custom">
                <label asp-for="JobTitle">Job Title *</label>
                <input asp-for="JobTitle" class="form-control-custom" placeholder="e.g., Senior Systems Analyst" required />
                <span asp-validation-for="JobTitle" class="text-danger small"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 form-group-custom">
                <label asp-for="DepartmentId">Department *</label>
                <select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-control-custom" required>
                    <option value="">-- Select Department --</option>
                </select>
                <span asp-validation-for="DepartmentId" class="text-danger small"></span>
            </div>
            <div class="col-md-6 form-group-custom">
                <label asp-for="HireDate">Hire Date *</label>
                <input asp-for="HireDate" type="date" class="form-control-custom" required />
                <span asp-validation-for="HireDate" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex align-items-center justify-content-end gap-2 mt-4 pt-3 border-top">
            <a asp-action="Index" class="btn-skill-outline">Cancel</a>
            <button type="submit" class="btn-skill-primary">
                <span class="material-symbols-outlined" style="font-size: 18px;">save</span>
                <span>Save Changes</span>
            </button>
        </div>
    </form>
</div>
