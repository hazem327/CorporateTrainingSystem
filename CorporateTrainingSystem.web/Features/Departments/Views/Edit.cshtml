@model CorporateTrainingSystem.Application.Features.Departments.UpdateDepartment.UpdateDepartmentCommand
@{
    ViewData["Title"] = "Edit Department";
}

<div class="page-header-row mb-4">
    <div>
        <div class="page-badge-label">
            <span class="page-badge-dot"></span>
            Organizational Structure
        </div>
        <h1 class="page-title">Edit Department</h1>
        <p class="page-subtitle">Update department details and description.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn-skill-outline">
            <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back</span>
            <span>Back to Departments</span>
        </a>
    </div>
</div>

<div class="form-card-container">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="form-group-custom">
            <label asp-for="Name">Department Name *</label>
            <input asp-for="Name" class="form-control-custom" placeholder="e.g., Quality Assurance, Logistics, People Ops" required />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="form-group-custom">
            <label asp-for="Description">Description</label>
            <textarea asp-for="Description" class="form-control-custom" rows="3" placeholder="Brief outline of department responsibilities and mission..."></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="d-flex align-items-center justify-content-end gap-2 mt-4 pt-3 border-top">
            <a asp-action="Index" class="btn-skill-outline">Cancel</a>
            <button type="submit" class="btn-skill-primary">
                <span class="material-symbols-outlined" style="font-size: 18px;">save</span>
                <span>Save Changes</span>
            </button>
        </div>
    </form>
</div>