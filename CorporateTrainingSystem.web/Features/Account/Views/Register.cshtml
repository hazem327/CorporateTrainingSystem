@model CorporateTrainingSystem.Web.Features.Account.RegisterViewModel
@{
    ViewData["Title"] = "Add User Account";
    var roles = ViewBag.Roles as string[] ?? Array.Empty<string>();
}

<div class="page-header-row mb-4">
    <div>
        <div class="page-badge-label">
            <span class="page-badge-dot"></span>
            Identity &amp; RBAC
        </div>
        <h1 class="page-title">Create User Account</h1>
        <p class="page-subtitle">Provision application login credentials and assign role permissions.</p>
    </div>
    <div>
        <a asp-controller="Home" asp-action="Index" class="btn-skill-outline">
            <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back</span>
            <span>Dashboard</span>
        </a>
    </div>
</div>

<div class="form-card-container">
    <form asp-action="Register" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-group-custom">
            <label asp-for="Email">Email Address *</label>
            <input asp-for="Email" type="email" class="form-control-custom" placeholder="name@company.com" required />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="row">
            <div class="col-md-6 form-group-custom">
                <label asp-for="Password">Password (min 8 chars) *</label>
                <input asp-for="Password" type="password" class="form-control-custom" placeholder="Enter secure password" required />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="col-md-6 form-group-custom">
                <label asp-for="ConfirmPassword">Confirm Password *</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control-custom" placeholder="Re-enter password" required />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 form-group-custom">
                <label asp-for="Role">System Role *</label>
                <select asp-for="Role" class="form-control-custom" required>
                    <option value="">-- Select Role --</option>
                    @foreach (var role in roles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>
            <div class="col-md-6 form-group-custom">
                <label asp-for="EmployeeId">Linked Employee ID (Optional)</label>
                <input asp-for="EmployeeId" type="number" class="form-control-custom" placeholder="e.g., 1" />
                <div class="form-hint">Links this login account to an employee profile.</div>
            </div>
        </div>

        <div class="d-flex align-items-center justify-content-end gap-2 mt-4 pt-3 border-top">
            <a asp-controller="Home" asp-action="Index" class="btn-skill-outline">Cancel</a>
            <button type="submit" class="btn-skill-primary">
                <span class="material-symbols-outlined" style="font-size: 18px;">person_add</span>
                <span>Create User</span>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}