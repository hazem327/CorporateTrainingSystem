@model CorporateTrainingSystem.Application.Features.Sessions.CreateSession.CreateSessionCommand
@{
    ViewData["Title"] = "Schedule Session";
}

<div class="page-header-row mb-4">
    <div>
        <div class="page-badge-label">
            <span class="page-badge-dot"></span>
            Scheduling &amp; Logistics
        </div>
        <h1 class="page-title">Schedule Training Session</h1>
        <p class="page-subtitle">Configure session dates, select certified instructor, set capacity limits, and specify location.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn-skill-outline">
            <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back</span>
            <span>Back to Sessions</span>
        </a>
    </div>
</div>

<div class="form-card-container">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="form-group-custom">
            <label asp-for="CourseId">Training Course *</label>
            <select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-control-custom" required>
                <option value="">-- Select Course --</option>
            </select>
            <span asp-validation-for="CourseId" class="text-danger small"></span>
        </div>

        <div class="form-group-custom">
            <label asp-for="InstructorId">Instructor *</label>
            <select asp-for="InstructorId" asp-items="ViewBag.Instructors" class="form-control-custom" required>
                <option value="">-- Select Instructor --</option>
            </select>
            <span asp-validation-for="InstructorId" class="text-danger small"></span>
        </div>

        <div class="row">
            <div class="col-md-6 form-group-custom">
                <label asp-for="StartDate">Start Date *</label>
                <input asp-for="StartDate" class="form-control-custom" type="date" required />
                <span asp-validation-for="StartDate" class="text-danger small"></span>
            </div>
            <div class="col-md-6 form-group-custom">
                <label asp-for="EndDate">End Date *</label>
                <input asp-for="EndDate" class="form-control-custom" type="date" required />
                <div class="form-hint">Must be on or after the start date.</div>
                <span asp-validation-for="EndDate" class="text-danger small"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 form-group-custom">
                <label asp-for="Capacity">Seat Capacity *</label>
                <input asp-for="Capacity" type="number" min="1" class="form-control-custom" placeholder="e.g., 20" required />
                <div class="form-hint">Strict maximum enrollment limit (BR-02).</div>
                <span asp-validation-for="Capacity" class="text-danger small"></span>
            </div>
            <div class="col-md-6 form-group-custom">
                <label asp-for="Location">Location / Delivery Method *</label>
                <input asp-for="Location" class="form-control-custom" placeholder="e.g., Room 402, Building B or Teams" required />
                <span asp-validation-for="Location" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex align-items-center justify-content-end gap-2 mt-4 pt-3 border-top">
            <a asp-action="Index" class="btn-skill-outline">Cancel</a>
            <button type="submit" class="btn-skill-primary">
                <span class="material-symbols-outlined" style="font-size: 18px;">save</span>
                <span>Schedule Session</span>
            </button>
        </div>
    </form>
</div>