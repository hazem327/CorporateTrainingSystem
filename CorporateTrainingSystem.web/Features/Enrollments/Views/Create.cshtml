@model CorporateTrainingSystem.Application.Features.Enrollments.EnrollEmployee.EnrollEmployeeCommand
@{
    ViewData["Title"] = "Enroll in Session";
    bool isSelfEnrollment = ViewBag.IsSelfEnrollment == true;
}

<div class="page-header-row mb-4">
    <div>
        <div class="page-badge-label">
            <span class="page-badge-dot"></span>
            Enrollment Flow
        </div>
        <h1 class="page-title">@(isSelfEnrollment ? "Enroll in Training Session" : "Enroll Employee")</h1>
        <p class="page-subtitle">Select learner profile and choose an open session with verified remaining seat capacity.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn-skill-outline">
            <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back</span>
            <span>Back to Enrollments</span>
        </a>
    </div>
</div>

<div class="form-card-container">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        @if (isSelfEnrollment)
        {
            <input type="hidden" asp-for="EmployeeId" />
            <div class="form-group-custom">
                <label>Learner Profile</label>
                <div class="d-flex align-items-center gap-2 p-2 bg-light rounded">
                    <span class="material-symbols-outlined text-primary">person</span>
                    <strong>@ViewBag.CurrentEmployeeName</strong>
                    <span class="status-badge valid ms-auto">Self-Enrollment</span>
                </div>
            </div>
        }
        else
        {
            <div class="form-group-custom">
                <label asp-for="EmployeeId">Select Employee *</label>
                <select asp-for="EmployeeId" asp-items="ViewBag.Employees" class="form-control-custom" required>
                    <option value="">-- Select Employee --</option>
                </select>
                <span asp-validation-for="EmployeeId" class="text-danger small"></span>
            </div>
        }

        <div class="form-group-custom">
            <label asp-for="TrainingSessionId">Available Training Session *</label>
            <select asp-for="TrainingSessionId" asp-items="ViewBag.Sessions" class="form-control-custom" required>
                <option value="">-- Select Available Training Session --</option>
            </select>
            <span asp-validation-for="TrainingSessionId" class="text-danger small"></span>
            <div class="form-hint">
                <span class="material-symbols-outlined" style="font-size: 14px; vertical-align: middle;">info</span>
                Only active, scheduled sessions with remaining capacity are listed. Duplicate enrollments are prevented (BR-01, BR-02).
            </div>
        </div>

        <div class="d-flex align-items-center justify-content-end gap-2 mt-4 pt-3 border-top">
            <a asp-action="Index" class="btn-skill-outline">Cancel</a>
            <button type="submit" class="btn-skill-primary">
                <span class="material-symbols-outlined" style="font-size: 18px;">how_to_reg</span>
                <span>Complete Enrollment</span>
            </button>
        </div>
    </form>
</div>
