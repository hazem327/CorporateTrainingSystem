@model List<CorporateTrainingSystem.Application.Features.Enrollments.ListEnrollments.EnrollmentListItem>
@{
    ViewData["Title"] = "Enrollments";
}

<h2>Enrollments</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a asp-action="Create" class="btn btn-primary">
            @(User.IsInRole("Administrator") || User.IsInRole("TrainingManager") ? "Enroll Employee" : "Enroll in Session")
        </a>
        <a asp-action="History" class="btn btn-outline-secondary ms-2">
            @(User.IsInRole("Administrator") || User.IsInRole("TrainingManager") ? "Training History" : "My Training History")
        </a>
    </div>
</div>

@if (User.IsInRole("Administrator") || User.IsInRole("TrainingManager"))
{
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Filter by Employee</label>
                    <select name="employeeId" asp-items="ViewBag.FilterEmployees" class="form-select">
                        <option value="">-- All Employees --</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label">Filter by Session</label>
                    <select name="sessionId" asp-items="ViewBag.FilterSessions" class="form-select">
                        <option value="">-- All Sessions --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-secondary">Filter</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        No enrollments found.
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Employee</th>
                <th>Department</th>
                <th>Course</th>
                <th>Session Dates</th>
                <th>Location</th>
                <th>Enrolled On</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <strong>@item.EmployeeName</strong>
                        <div class="text-muted small">@item.EmployeeNumber</div>
                    </td>
                    <td>@item.DepartmentName</td>
                    <td>@item.CourseTitle</td>
                    <td>
                        @item.StartDate.ToString("yyyy-MM-dd") to @item.EndDate.ToString("yyyy-MM-dd")
                    </td>
                    <td>@item.Location</td>
                    <td>@item.EnrolledAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        @if (item.Status == "Active")
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else if (item.Status == "Cancelled")
                        {
                            <span class="badge bg-secondary">Cancelled</span>
                        }
                        else if (item.Status == "Completed")
                        {
                            <span class="badge bg-primary">Completed</span>
                        }
                        else
                        {
                            <span class="badge bg-info">@item.Status</span>
                        }
    @if (item.Status == "Active")
{
    <a asp-controller="Assessments" asp-action="Record" asp-route-enrollmentId="@item.Id" class="btn btn-sm btn-outline-primary">Record Result</a>
}
@if (item.Status == "Completed")
{
    <form asp-controller="Certifications" asp-action="Issue" asp-route-enrollmentId="@item.Id" method="post" class="d-inline">
        <button type="submit" class="btn btn-sm btn-outline-success">Issue Certificate</button>
    </form>
}
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            @if (item.CanCancel)
                            {
                                <form asp-action="Cancel" method="post" onsubmit="return confirm('Are you sure you want to cancel this enrollment?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Cancel</button>
                                </form>
                            }
                            <a asp-action="History" asp-route-employeeId="@item.EmployeeId" class="btn btn-outline-primary btn-sm">History</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
