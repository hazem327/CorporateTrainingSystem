@model CorporateTrainingSystem.Application.Features.Assessments.RecordAssessmentResult.RecordAssessmentResultCommand
@{
    ViewData["Title"] = "Record Assessment";
}

<div class="page-header-row mb-4">
    <div>
        <div class="page-badge-label">
            <span class="page-badge-dot"></span>
            Grading &amp; Attendance
        </div>
        <h1 class="page-title">Record Attendance &amp; Assessment</h1>
        <p class="page-subtitle">Verify employee presence and enter final assessment examination grade (0 - 100%).</p>
    </div>
    <div>
        <a asp-controller="Enrollments" asp-action="Index" class="btn-skill-outline">
            <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back</span>
            <span>Back to Enrollments</span>
        </a>
    </div>
</div>

<div class="form-card-container">
    <form asp-action="Record" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="EnrollmentId" />

        <div class="form-group-custom p-3 bg-light rounded d-flex align-items-center justify-content-between">
            <div>
                <label class="mb-0 font-weight-bold">Learner Attendance Confirmation</label>
                <div class="form-hint">Confirm whether the employee attended the scheduled sessions.</div>
            </div>
            <div class="form-check form-switch m-0">
                <input type="checkbox" name="isPresent" class="form-check-input" value="true" checked id="switchAttendance" style="width: 44px; height: 22px;" />
            </div>
        </div>

        <div class="form-group-custom mt-3">
            <label asp-for="Score">Exam / Assessment Score (0 - 100) *</label>
            <input asp-for="Score" type="number" min="0" max="100" class="form-control-custom" placeholder="e.g., 85" required />
            <div class="form-hint">
                <span class="material-symbols-outlined" style="font-size: 14px; vertical-align: middle;">info</span>
                Passing threshold is defined by the course settings. Scores ≥ passing score will qualify for certificate issuance (BR-03, BR-04).
            </div>
            <span asp-validation-for="Score" class="text-danger small"></span>
        </div>

        <div class="d-flex align-items-center justify-content-end gap-2 mt-4 pt-3 border-top">
            <a asp-controller="Enrollments" asp-action="Index" class="btn-skill-outline">Cancel</a>
            <button type="submit" class="btn-skill-primary">
                <span class="material-symbols-outlined" style="font-size: 18px;">check_circle</span>
                <span>Submit Assessment</span>
            </button>
        </div>
    </form>
</div>